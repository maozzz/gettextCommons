msgstr "Брайан и Эллисон Кэллауэй"

#: application/views/scripts/translations/jury.phtml:37
msgid "Donatella Barbera & Damiano Salvadori"
msgstr "Донателла Барбера и Дамиано Сальвадори"

#: application/views/scripts/translations/jury.phtml:38
msgid "Ross Harvey"
msgstr "Росс Харви"

#: application/views/scripts/translations/jury.phtml:39
