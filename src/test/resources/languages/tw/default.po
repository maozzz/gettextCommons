msgstr "您可以在此頁面上指定不同的連結：%s"

#: application/views/private_messages/remind_family_award.phtml:1
#: application/views/scripts/translations/notused.phtml:855
#, php-format
msgid "%s free participation period expires soon."
msgstr "%s免費參賽期間即將結束。"

#: application/views/private_messages/remind_family_award.phtml:3
#: application/views/scripts/translations/notused.phtml:859
