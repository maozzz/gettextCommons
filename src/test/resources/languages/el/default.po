#: application/views/scripts/translations/reasons.phtml:97
msgid "The photo is irrelevant"
msgid_plural "The photos are irrelevant"
msgstr[0] "Η φωτογραφία δεν είναι σχετική"
msgstr[1] "Οι φωτογραφίες δεν είναι σχετικές"

