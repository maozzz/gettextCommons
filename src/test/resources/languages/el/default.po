msgstr "Spam σε προσωπικά μηνύματα"

#: application/views/scripts/translations/reasons.phtml:46
#: application/views/scripts/translations/videographers.phtml:378
msgid "Video does not correspond to the MyWed rules"
msgid_plural "Videos do not correspond to the MyWed rules"
