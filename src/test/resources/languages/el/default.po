msgstr "Παρόμοιες ή ολόιδιες φωτογραφίες"

#: application/views/scripts/translations/reasons.phtml:51
msgid "The pictures feature a repetitive subject matter or the same locations. We do not consider several variants of one shot to be separate independent photographs."
msgstr "Οι φωτογραφίες παρουσιάζουν ένα επαναλαμβανόμενο θέμα ή τις ίδιες τοποθεσίες. Δεν θεωρούμε τις διάφορες εναλλακτικές μιας λήψης ως ανεξάρτητες φωτογραφίες."

#: application/views/scripts/translations/reasons.phtml:61
#: application/views/scripts/translations/reasons.phtml:75
msgid "Inappropriate or explicit content"
msgstr "Ακατάλληλο ή άσεμνο περιεχόμενο"

#: application/views/scripts/translations/reasons.phtml:62
#: application/views/scripts/translations/reasons.phtml:83
msgid "Rating cheat"
msgstr "Εξαπάτηση βαθμολογίας"

#: application/views/scripts/translations/reasons.phtml:63
msgid "Photo is taken at a workshop"
msgid_plural "Photos are taken at a workshop"
msgstr[0] "Η φωτογραφία τραβήχτηκε σε εργαστήριο"
msgstr[1] "Οι φωτογραφίες τραβήχτηκαν σε εργαστήριο"

