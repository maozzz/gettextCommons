msgid_plural "Images do not correspond to the MyWed rules"
msgstr[0] "Η εικόνα δεν ανταποκρίνεται στους κανόνες MyWed"
msgstr[1] "Οι εικόνες δεν ανταποκρίνονται στους κανόνες MyWed"

#: application/views/scripts/translations/reasons.phtml:49
msgid "Forged photo or photo taken at a workshop"
msgid_plural "Forged photos or photos taken at a workshop"
msgstr[0] "Πλαστή φωτογραφία ή φωτογραφία που τραβήχτηκε σε μάθημα"
msgstr[1] "Πλαστές φωτογραφίες ή φωτογραφίες που τραβήχτηκαν σε μάθημα"

