#: application/views/scripts/photographer/view.phtml:434
#: application/views/scripts/translations/notused.phtml:181
#: application/views/scripts/user/_categories.phtml:219
#, php-format
msgid "Besides, uploading limits are special as well: you can always upload %1$s photo a day and %2$s series a week regardless of your account type."
