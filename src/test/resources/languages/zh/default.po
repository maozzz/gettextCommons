#: application/views/scripts/translations/competition_nominations.phtml:214
msgid "Imperfect beauty"
msgstr "缺陷之美"

#: application/views/private_messages/award_announce.phtml:11
#: application/views/scripts/translations/competition_nominations.phtml:215
msgid "When imperfection gets value"
msgstr "当不完美变得意义重大"

