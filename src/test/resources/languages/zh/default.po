msgstr "让“空白”占据画面，言有尽而意无穷"

#: application/views/private_messages/award_announce_new.phtml:7
#: application/views/scripts/translations/competition_nominations.phtml:256
msgid "Golden Mistake"
msgstr "《无心插柳》"

#: application/views/private_messages/award_announce_new.phtml:8
#: application/views/scripts/translations/competition_nominations.phtml:257
msgid "An intuitive, \"bad\" composition that just works"
msgstr "直觉引领创新，看似“失误”的构图却带来了不一样的惊喜"

#: application/views/private_messages/award_announce_new.phtml:9
#: application/views/scripts/translations/competition_nominations.phtml:258
