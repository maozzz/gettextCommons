msgid "Sergey Korolev"
msgstr ""

#: application/views/scripts/translations/jury.phtml:31
msgid "CEO and Founder of MyWed"
msgstr "MyWed首席执行官兼创始人"

#: application/views/scripts/translations/jury.phtml:34
msgid "Pete Farell"
msgstr ""

#: application/views/scripts/translations/jury.phtml:35
msgid "Massimiliano Magliacca"
