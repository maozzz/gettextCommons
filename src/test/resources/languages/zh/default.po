#: application/views/scripts/translations/reasons.phtml:6
#: application/views/scripts/translations/reasons.phtml:37
#, php-format
msgid "We have reasons to think that this photo belongs to another person. Please contact us at %s to clarify this situation."
msgid_plural "We have reasons to think that these photos belong to another person. Please contact us at %s to clarify this situation."
msgstr[0] "我们有理由相信这些图片属于其他人。请通过%s联系我们以便对情况作出澄清。"

#: application/views/scripts/translations/reasons.phtml:8
#: application/views/scripts/translations/reasons.phtml:11
msgid "Borders or stripes around the image"
msgid_plural "Borders or stripes around the images"
msgstr[0] "图片边框或条纹"

#: application/views/scripts/translations/reasons.phtml:9
msgid "We think that an image looks better having no stripes around it or on its sides. Don't you agree?<br/>Let's forget about borders and keep photos beautiful."
msgid_plural "We think that images look better having no stripes around them or on their sides. Don't you agree?<br/>Let's forget about borders and keep photos beautiful."
msgstr[0] "我们认为在照片的四周或其边上没有条纹会更好看。您不同意吗？让我们忘却边框并保持照片美观。"

#: application/views/scripts/translations/reasons.phtml:12
msgid "Several shots inside one image"
msgstr "一张图片内的数次拍摄"

#: application/views/scripts/translations/reasons.phtml:13
msgid "Let's be honest with ourselves. Several shots compiled inside one image is not a photograph. It's a collage. Please upload each photo separately."
msgstr "让我们对自己诚实一点。多次拍摄合成的一张图片不属于摄影作品。而是一张拼贴画。请分别上传每一张照片。"

#: application/views/scripts/translations/reasons.phtml:14
msgid "Since MyWed is a wedding photographers' community, we publish pre-wedding, wedding and engagement photos only."
msgstr "因为MyWed是一个婚礼摄影师社区，所以我们只发布婚礼前、婚礼和订婚照片。"

#: application/views/scripts/translations/reasons.phtml:15
msgid "Non-wedding image"
msgid_plural "Non-wedding images"
msgstr[0] "非婚礼照片"

#: application/views/scripts/translations/reasons.phtml:16
msgid "Design objects on the image"
msgid_plural "Design objects on images"
msgstr[0] "图片上的设计对象"

#: application/views/scripts/translations/reasons.phtml:17
msgid "We think that huge logos, lines, stripes, text and other design elements hide your photo under themselves.<br/>Images without such elements look really better."
msgid_plural "We think that huge logos, lines, stripes, text and other design elements hide your photos under themselves.<br/>Images without such elements look really better."
msgstr[0] "我们认为巨大的标志、线条、条纹、文本和其他设计元素将会把您的照片隐藏在它们之下。没有此类元素的照片看上去更好。"

#: application/views/scripts/translations/reasons.phtml:19
msgid "Excessive post-production"
msgstr "过度的后期制作"

#: application/views/scripts/translations/reasons.phtml:21
msgid "Poor composition, cropping or conceptual idea. Please submit only the best photos."
msgstr "差强人意的构图、剪切或概念。请只提交最优秀的照片。"

#: application/views/scripts/translations/reasons.phtml:22
#: application/views/scripts/translations/videographers.phtml:365
msgid "Sexually explicit content"
msgstr "色情内容"

#: application/views/scripts/translations/reasons.phtml:24
#: application/views/scripts/translations/videographers.phtml:355
msgid "Non-wedding video"
msgid_plural "Non-wedding videos"
msgstr[0] "非婚礼视频"

#: application/views/scripts/translations/reasons.phtml:26
#: application/views/scripts/translations/videographers.phtml:357
msgid "Adding photo slideshows"
msgstr "添加电子相册"

#: application/views/scripts/translations/reasons.phtml:27
#: application/views/scripts/translations/videographers.phtml:359
msgid "MyWed is devoted to wedding videos, not photo presentations."
msgstr "MyWed致力于婚礼视频，而不是照片展示."

#: application/views/scripts/translations/reasons.phtml:28
#: application/views/scripts/translations/videographers.phtml:361
msgid "We don't welcome videos bursting with special effects, clipart and animation."
msgstr "我们不欢迎充斥着特效、剪贴画和动画的视频。"

#: application/views/scripts/translations/reasons.phtml:29
msgid "Insufficient level of visual and technical skills"
msgstr "低水平的可视化和技术技能"

#: application/views/scripts/translations/reasons.phtml:30
#: application/views/scripts/translations/videographers.phtml:363
msgid "Low-quality footage, editing or weak conceptual idea. Please submit only the best videos."
msgstr "低质量镜头、剪辑或苍白的概念构想。请只提交最优秀的视频。"

#: application/views/scripts/translations/reasons.phtml:31
#: application/views/scripts/translations/videographers.phtml:376
msgid "Offensive content"
msgstr "侵犯性内容"

#: application/views/scripts/translations/reasons.phtml:32
msgid "We are for world peace and that's why we don't publish offensive content."
msgstr "我们热爱世界和平。因此，我们不会发布攻击性内容。"

#: application/views/scripts/translations/reasons.phtml:33
#: application/views/scripts/translations/videographers.phtml:367
msgid "Video might be filmed by another person"
msgid_plural "Videos might be filmed by another person"
msgstr[0] "视频可能由其他人拍摄"

#: application/views/scripts/translations/reasons.phtml:35
msgid "Cheating the MyWed rating system"
msgstr "欺骗MyWed评级系统"

#: application/views/scripts/translations/reasons.phtml:36
msgid "Looks like this image is owned by another person"
msgid_plural "Looks like these images are owned by another person"
msgstr[0] "似乎这张图片是其他人所有"

#: application/views/scripts/translations/reasons.phtml:38
#: application/views/scripts/translations/videographers.phtml:369
msgid "Incorrect name and surname in your profile"
msgstr "您个人资料中的名字和姓出错"

#: application/views/scripts/translations/reasons.phtml:39
#: application/views/scripts/translations/videographers.phtml:370
msgid "You can only use your real name and surname in the profile. Studio names or names of several people are not allowed."
msgstr "在您的个人资料中，您只可以使用您的真实名字和姓。不允许使用工作室名称或几个不同人员的姓名。"

#: application/views/scripts/translations/reasons.phtml:40
#: application/views/scripts/translations/reasons.phtml:42
#: application/views/scripts/translations/videographers.phtml:372
msgid "Video is staged or taken at a workshop"
msgid_plural "Videos are staged or taken at a workshop"
msgstr[0] "视频是在工作室中编排或拍摄"

#: application/views/scripts/translations/reasons.phtml:41
#: application/views/scripts/translations/videographers.phtml:374
msgid "Videos from workshops and staged events are not accepted."
msgstr "不接受来自工作室或舞台活动的视频。"

#: application/views/scripts/translations/reasons.phtml:43
msgid "Inappropriate behaviour in the MyWed forum"
msgstr "在MyWed论坛的不当行为"

#: application/views/scripts/translations/reasons.phtml:44
msgid "Repeated uploading of photos which has been deleted by MyWed editors"
msgstr "重复上传已被MyWed编辑删除的照片"

#: application/views/scripts/translations/reasons.phtml:45
