#: application/views/scripts/translations/competition_nominations.phtml:217
msgid "Nice guys"
msgstr "好基友"

#: application/views/private_messages/award_announce.phtml:13
#: application/views/scripts/translations/competition_nominations.phtml:218
msgid "The wedding comes first. After friends of course"
msgstr "婚礼是头等大事。当然这是在好友之后"

